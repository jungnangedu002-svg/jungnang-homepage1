{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/set-site-url.js",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
